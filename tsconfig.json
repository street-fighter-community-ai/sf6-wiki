{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": [
    "scraper/**/*.ts",
    "docs/.vitepress/**/*.ts",
    "docs/.vitepress/**/*.d.ts",
    "vitest.config.ts"
  ]
}
